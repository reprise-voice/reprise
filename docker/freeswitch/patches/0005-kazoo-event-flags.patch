+ int i;
+ /* Nothing allocates under flag_mutex: the caller supplies the buffer. */
+ buf[0] = '\0';
+ switch_mutex_lock(channel->flag_mutex);
+ for (i = 0; i < CF_FLAG_MAX; i++) {
+  size_t len;
+  if (!channel->flags[i] || !names[i]) continue;
+  len = strlen(names[i]);
+  if (used + len + 2 > buflen) break;
+  if (used) buf[used++] = '|';
+  memcpy(buf + used, names[i], len);
+  used += len;
+  buf[used] = '\0';
+ }
+ switch_mutex_unlock(channel->flag_mutex);
