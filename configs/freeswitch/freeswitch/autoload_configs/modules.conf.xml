<configuration name="modules.conf" description="Modules">
    <modules>
        <!-- Not loaded, because the Reprise FreeSWITCH image does not build
             them: mod_av, mod_siren, mod_ilbc, mod_amrwb and mod_imagick.
             Add a load line for one after building it. -->

        <!-- Loggers -->
        <load module="mod_console"/>
        <load module="mod_logfile"/>
        <!--<load module="mod_syslog"/>-->

        <!-- XML Interfaces -->

        <!-- Event Handlers -->
        <load module="mod_event_socket"/>
        <load module="mod_kazoo" />

        <!-- Directory Interfaces -->
        <load module="mod_dialplan_xml"/>

        <!-- Endpoints -->
        <!-- NOTE: mod_sofia should not be loaded here. It will be loaded by eCallMgr when we're ready to receive calls -->
        <load module="mod_loopback"/>

        <!-- Applications -->
        <load module="mod_commands"/>
        <load module="mod_conference"/>
        <load module="mod_dptools"/>
        <load module="mod_expr"/>
        <load module="mod_http_cache"/>

        <!-- Codec Interfaces -->
        <load module="mod_spandsp"/>
        <load module="mod_g723_1"/>
        <load module="mod_opus"/>
        <load module="mod_amr"/>

        <!--
        <load module="mod_red"/>
        <load module="mod_ulpfec"/>
        -->


        <!-- File Format Interfaces -->
        <load module="mod_sndfile"/>
        <load module="mod_local_stream"/>
        <load module="mod_tone_stream"/>
        <load module="mod_shout"/>
        <load module="mod_png"/>

        <!-- Timers -->

        <!-- Languages -->

        <!-- ASR /TTS -->
        <load module="mod_flite"/>

        <!-- Say -->
        <load module="mod_say_en"/>

        <!-- Third party modules -->

    </modules>
</configuration>
