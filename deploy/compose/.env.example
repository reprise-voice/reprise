# The settings of the test cluster. ./init-env.sh writes .env from this
# file, with HOST_IP for this machine and fresh random credentials; the
# three credentials below are empty here on purpose, and the cluster does
# not start until they are set. Docker Compose reads .env from this
# directory; bootstrap.sh reads it too. Keep values free of spaces and
# quotes.

# The address phones and browsers use to reach this machine: its LAN
# address, never 127.0.0.1. It is advertised in SIP and SDP, and the SIP,
# RTP and UI ports are published on it.
HOST_IP=192.168.1.50

# Publish the ports on another address than HOST_IP, e.g. 0.0.0.0 when
# Docker Desktop cannot bind HOST_IP. Empty = HOST_IP.
BIND_IP=

# Images: ghcr.io/reprise-voice/reprise{,-freeswitch,-kamailio,-monster-ui}
REPRISE_REGISTRY=ghcr.io/reprise-voice
REPRISE_TAG=latest

# Variants (see README.md), one of:
#   COMPOSE_FILE=compose.yaml:compose.build.yaml
#   COMPOSE_FILE=compose.yaml:compose.host-network.yaml
#COMPOSE_FILE=compose.yaml

# Erlang cookie shared by both Kazoo nodes and by sup. Any word; it lets
# its holder run code on the nodes, so keep it secret.
KAZOO_COOKIE=

# CouchDB admin. Letters and digits only, starting with a letter: the
# password is written unquoted into the nodes' config.ini.
COUCHDB_USER=admin
COUCHDB_PASSWORD=

# What bootstrap.sh creates: the first (master) account and its admin user,
# the Monster UI login. The realm is the SIP domain phones register to.
ACCOUNT_NAME=reprise
ACCOUNT_REALM=demo.reprise.test
ADMIN_USER=admin
ADMIN_PASSWORD=

# The system prompts bootstrap.sh imports: languages separated by commas
# (en-us,fr-ca), or `all` for every language in the image (de-de, en-gb,
# en-us, es-es, es-us, fr-ca, fr-fr, nl-be, ru-ru). Each language takes a
# while to import; one already imported is left alone.
# `PROMPT_LANGUAGES=all ./bootstrap.sh` does it for one run.
PROMPT_LANGUAGES=en-us

# FreeSWITCH RTP ports, published 1:1 on HOST_IP. Two ports per call leg.
RTP_START_PORT=16384
RTP_END_PORT=16483

# Monster UI: http://HOST_IP:UI_PORT
UI_PORT=8080

# Ports published on 127.0.0.1 only, for looking around.
COUCHDB_LOCAL_PORT=5984
BROKER_UI_LOCAL_PORT=15672

# The container network's /24, if 172.30.10.0/24 is taken on this machine.
REPRISE_SUBNET=172.30.10

# Extra flags for the Erlang nodes. Only needed when the containers run
# under emulation (an arm64 host): ERL_FLAGS=+JMsingle true
#ERL_FLAGS=
