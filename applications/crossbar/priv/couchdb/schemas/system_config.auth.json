{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "system_config.auth",
    "description": "Schema for auth system_config",
    "properties": {
        "allow_tokens_without_expiry": {
            "default": false,
            "description": "Accept a JWT that carries no exp claim; off, such a token is rejected",
            "type": "boolean"
        },
        "default_multi_factor_provider": {
            "default": "duo",
            "description": "Default multi factor authentication provider name",
            "type": "string"
        },
        "gce_metadata_url": {
            "default": "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token",
            "description": "URL the gce_metadata auth provider fetches service-account access tokens from",
            "type": "string"
        },
        "qrcode_initial_counter": {
            "default": 2600,
            "description": "auth qrcode_initial_counter",
            "type": "integer"
        },
        "qrcode_issuer": {
            "default": "KAZOO",
            "description": "auth qrcode_issuer",
            "type": "string"
        },
        "qrcode_key_type": {
            "default": "totp",
            "description": "auth qrcode_key_type",
            "type": "string"
        },
        "require_identity_signature": {
            "default": true,
            "description": "Reject a kazoo-issued JWT that carries no identity_sig claim, and refuse to mint one whose identity cannot be signed",
            "type": "boolean"
        },
        "secret_for_user_signature": {
            "description": "auth secret for user signature",
            "type": "string"
        },
        "system_key": {
            "description": "auth system key",
            "type": "string"
        },
        "totp_period_s": {
            "default": 30,
            "description": "auth totp_period_s",
            "type": "integer"
        }
    },
    "type": "object"
}
