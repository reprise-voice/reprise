{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "system_config.crossbar.auth",
    "description": "Schema for crossbar.auth system_config",
    "properties": {
        "auth_modules": {
            "additionalProperties": {
                "$ref": "auth_module_config"
            },
            "default": {
                "cb_api_auth": {
                    "enabled": true,
                    "log_failed_attempts": true,
                    "log_successful_attempts": false,
                    "scopes": [
                        "crossbar"
                    ],
                    "token_auth_expiry_s": 3600
                },
                "cb_auth": {
                    "enabled": true,
                    "log_failed_attempts": true,
                    "log_successful_attempts": false,
                    "scopes": [
                        "crossbar"
                    ],
                    "token_auth_expiry_s": 3600
                },
                "cb_conference_auth": {
                    "enabled": true,
                    "log_failed_attempts": true,
                    "log_successful_attempts": false,
                    "scopes": [
                        "crossbar"
                    ],
                    "token_auth_expiry_s": 3600
                },
                "cb_desktop_auth": {
                    "enabled": true,
                    "log_failed_attempts": true,
                    "log_successful_attempts": true,
                    "scopes": [
                        "crossbar"
                    ],
                    "token_auth_expiry_s": 3600
                },
                "cb_ip_auth": {
                    "enabled": true,
                    "log_failed_attempts": true,
                    "log_successful_attempts": false,
                    "scopes": [
                        "crossbar"
                    ],
                    "token_auth_expiry_s": 3600
                },
                "cb_user_auth": {
                    "enabled": true,
                    "log_failed_attempts": true,
                    "log_successful_attempts": true,
                    "scopes": [
                        "crossbar"
                    ],
                    "token_auth_expiry_s": 3600
                }
            },
            "description": "Default crossbar authentication modules configuration",
            "properties": {
                "cb_api_auth": {
                    "$ref": "auth_module_config"
                },
                "cb_auth": {
                    "$ref": "auth_module_config"
                },
                "cb_conference_auth": {
                    "$ref": "auth_module_config"
                },
                "cb_desktop_auth": {
                    "$ref": "auth_module_config"
                },
                "cb_ip_auth": {
                    "$ref": "auth_module_config"
                },
                "cb_user_auth": {
                    "$ref": "auth_module_config"
                }
            },
            "type": "object"
        },
        "available_auth_methods": {
            "default": [
                "cb_user_auth",
                "cb_api_auth",
                "cb_auth",
                "cb_ip_auth",
                "cb_desktop_auth"
            ],
            "description": "List of crossbar auth configurable modules",
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "basic_auth_type": {
            "default": "md5",
            "description": "crossbar.auth basic auth type",
            "enum": [
                "md5",
                "sha"
            ],
            "type": "string"
        },
        "external_auth_methods": {
            "default": [],
            "description": "Token methods minted by another application (with kz_auth:create_token/1) rather than by a crossbar auth module; each gets a default auth_modules entry, joins the available_auth_methods default and can key token restrictions",
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "lock_account_on_failed_attempts": {
            "default": false,
            "description": "crossbar auth lock_account_on_failed_attempts",
            "type": "boolean"
        },
        "log_failed_attempts": {
            "default": false,
            "description": "Should log failed login attempts",
            "type": "boolean"
        },
        "log_failed_login_attempts": {
            "default": false,
            "description": "Should log failed login attempts",
            "type": "boolean"
        },
        "log_successful_attempts": {
            "default": false,
            "description": "Should log successful login attempts",
            "type": "boolean"
        },
        "max_token_lifetime_s": {
            "default": 31540000,
            "description": "Longest lifetime of an auth token in seconds; the exp claim of a token whose method is configured with \"infinity\" or a non-positive expiry, and the cap on any configured expiry",
            "type": "integer"
        },
        "token_auth_expiry_s": {
            "default": 3600,
            "description": "crossbar token auth expiry in seconds",
            "type": "integer"
        }
    },
    "type": "object"
}
