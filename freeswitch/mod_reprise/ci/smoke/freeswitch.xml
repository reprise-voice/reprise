<document type="freeswitch/xml">
  <section name="configuration" description="smoke-test configuration">
    <configuration name="modules.conf" description="Modules">
      <modules>
        <load module="mod_console"/>
        <load module="mod_logfile"/>
        <load module="mod_commands"/>
        <load module="mod_dptools"/>
        <load module="mod_dialplan_xml"/>
        <load module="mod_loopback"/>
        <load module="mod_conference"/>
        <load module="mod_tone_stream"/>
        <load module="mod_event_socket"/>
        <load module="mod_reprise"/>
      </modules>
    </configuration>
    <configuration name="logfile.conf" description="File Logging">
      <settings>
        <param name="rotate-on-hup" value="true"/>
      </settings>
      <profiles>
        <profile name="default">
          <settings>
            <param name="logfile" value="/smoke/log/freeswitch.log"/>
            <param name="rollover" value="10485760"/>
          </settings>
          <mappings>
            <map name="all" value="debug,info,notice,warning,err,crit,alert"/>
          </mappings>
        </profile>
      </profiles>
    </configuration>
    <!-- static fallback: ecallmgr answers conference.conf profile fetches
         only for an account's conference, so a bare `conference(x@default)`
         from the CLI needs a local profile -->
    <configuration name="conference.conf" description="Conferences">
      <profiles>
        <profile name="default">
          <param name="rate" value="8000"/>
          <param name="interval" value="20"/>
          <param name="energy-level" value="100"/>
          <param name="comfort-noise" value="false"/>
        </profile>
      </profiles>
    </configuration>
    <configuration name="event_socket.conf" description="Socket">
      <settings>
        <param name="listen-ip" value="127.0.0.1"/>
        <param name="listen-port" value="8021"/>
        <param name="password" value="ClueCon"/>
      </settings>
    </configuration>
    <configuration name="reprise.conf" description="mod_reprise bootstrap">
      <settings>
        <param name="reconnect-interval-ms" value="2000"/>
        <param name="fetch-timeout-ms" value="3500"/>
        <param name="advertise-interval-ms" value="5000"/>
        <param name="trace-fetch" value="true"/>
      </settings>
      <connections>
        <connection name="primary">
          <param name="hostname" value="rabbitmq.example.com"/>
          <param name="port" value="5672"/>
          <param name="username" value="kazoo"/>
          <param name="password" value="change_me"/>
          <param name="virtualhost" value="/"/>
          <param name="heartbeat" value="30"/>
        </connection>
      </connections>
    </configuration>
  </section>
</document>
