%% elvis_core 4.x (elvis pinned in make/elvis.mk and core/kazoo_stdlib/deps.mk).
%%
%% The rules are listed on the config group itself: elvis_core 4.2.2 drops
%% custom rulesets before it resolves a group's rules, so a ruleset defined
%% under `rulesets` contributes nothing. `core_rules` stays defined (empty)
%% because the group's `ruleset` must name a known one.
%%
%% Not enabled, deliberately: operator_spaces and line_length (sheer number
%% of fails), dont_repeat_yourself (subjective), state_record_and_type,
%% no_used_ignored_variables (ignored variables are used in log messages).
[{elvis, [ {rulesets, #{core_rules => []}}
         ,{config, [#{dirs => ["applications/*/src/"
                              ,"applications/*/test/"
                              ,"applications/*/src/*/"
                              ,"applications/*/include/"
                              ,"core/*/src/"
                              ,"core/*/test/"
                              ,"core/*/src/*/"
                              ,"core/*/include/"

                               %% for kz.mk
                              ,"src/"
                              ,"src/*/"
                              ,"test/"
                              ,"include/"
                              ]
                     ,filter => "*.[e|h]rl"
                     ,ruleset => core_rules
                     ,rules => [ {elvis_text_style, no_trailing_whitespace, #{ignore_empty_lines => false}}
                               , {elvis_text_style, no_tabs}
                               , {elvis_style, no_god_modules, #{limit => 100, ignore => [kapi_dialplan]}}
                               , {elvis_style, no_call, #{no_call_functions => [{proplists, get_value}
                                                                               ,{proplists, delete}
                                                                               ,{proplists, get_all_values}
                                                                               ,{proplists, get_bool}
                                                                               ,{proplists, is_defined}
                                                                               ]}}
                                 %% Nesting level 1 is the function body itself.
                               , {elvis_style, no_deep_nesting, #{level => 4}}
                               , {elvis_style, no_behavior_info}
                               , {elvis_style, no_if_expression}
                               , {elvis_style, no_spec_with_records}
                               , {elvis_style, no_nested_try_catch}
                               , {elvis_style, no_debug_call}
                               , {elvis_style, no_common_caveats_call}
                               ]
                     }
                   ]
          }
         ,{output_format, colors}
         ,{verbose, true}
         ,{parallel, 8}]
 }].
